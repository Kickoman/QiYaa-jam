{
  "name": "qiyaa-jam",
  "private": true,
  "description": "QiYaa Jam: shared queue server and web guest",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "format": "prettier --write .",
